NEXT_PUBLIC_SITE_URL=https://refundmoneynow.com
# Create this in Google AI Studio and store it as a GitHub Actions secret named GEMINI_API_KEY.
GEMINI_API_KEY=
# Keep configurable because Google model availability can change.
GEMINI_MODEL=gemini-2.5-flash
# Optional: force one editorial slot while testing.
EDITORIAL_SLOT=
# Set to 1 to generate + audit without publishing.
EDITORIAL_DRY_RUN=0
